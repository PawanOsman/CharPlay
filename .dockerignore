# Allow only the inputs needed to build the application. This also excludes
# credentials, local build/dependency caches, archives, and host executables.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.ts
!next-env.d.ts
!tsconfig.json
!postcss.config.mjs
!components.json
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/**

# Never send secret files or generated caches, including nested copies.
**/.env
**/.env.*
**/.npmrc
**/.git
**/node_modules
**/.next
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
