PAWANKRD_API_KEY=
# Public origin; leave empty only for local development.
APP_ORIGIN=
# Set only behind a proxy that overwrites this header with a verified single IP.
TRUSTED_PROXY_IP_HEADER=
# If changed, use the same port during build and runtime.
SOCKET_PORT=4000
SOCKET_HOST=127.0.0.1
# Compose publishes only to localhost unless explicitly overridden.
BIND_ADDRESS=127.0.0.1
